        {
          "expr": "rate(mongodb_ss_metrics_document{doc_op=\"returned\"}[1m])",
          "legendFormat": "Returned/sec"
        },
        {
          "expr": "rate(mongodb_ss_metrics_document{doc_op=\"updated\"}[1m])",
