      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "title": "MongoDB Operations/sec",
      "description": "Insert, query, update, delete rates — shows how hard the pipeline pushes MongoDB",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(mongodb_ss_opcounters{type=\"insert\"}[1m])",
          "legendFormat": "Inserts/sec"
        },
        {
          "expr": "rate(mongodb_ss_opcounters{type=\"query\"}[1m])",
          "legendFormat": "Queries/sec"
        },
        {
          "expr": "rate(mongodb_ss_opcounters{type=\"update\"}[1m])",
          "legendFormat": "Updates/sec"
        },
        {
          "expr": "rate(mongodb_ss_opcounters{type=\"command\"}[1m])",
          "legendFormat": "Commands/sec"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
