# ─────────────────────────────────────────────────────────────────────
# NetPulse Environment Configuration
# Copy this file to .env and edit the values
# ─────────────────────────────────────────────────────────────────────

# The LAN IP address of this Linux server
# Windows agents will connect to Kafka at this IP on port 9092
# Find your IP with: hostname -I | awk '{print $1}'
SERVER_IP=192.168.1.100

# MongoDB settings (optional — defaults work for local dev)
# MONGO_USER=admin
# MONGO_PASS=netpulse123

# ML Analyser settings
ANOMALY_CONTAMINATION=0.05
ANALYSE_INTERVAL=60
